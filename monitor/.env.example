# Copy to .env and fill in. Never commit .env: both values give access to your accounts.

# Refresh token of the account the monitor uses. In a browser signed in to that account, on caser.gg,
# open the developer console (F12) and run:  localStorage.getItem('refresh_token')
# Then stop using that login in the browser (see README.md).
CASER_REFRESH_TOKEN=

# Supabase secret key: Supabase dashboard, Project Settings, API Keys, "Secret keys" (sb_secret_...).
# It can write everything in the project, so it stays on this server only.
SUPABASE_SECRET_KEY=

# Optional.
# SUPABASE_URL=https://hafnhxumrqyaljmciqqq.supabase.co
# RETENTION_DAYS=30
# CASER_BASE=https://caser.gg
# PULSE_GAP_MS=8000
