# Copy to .env and fill in. Never commit .env: both values give access to your accounts.

# Refresh token of the account the monitor uses. In a browser signed in to that account, on caser.gg,
# open the developer console (F12) and run:  localStorage.getItem('refresh_token')
# Then stop using that login in the browser (see README.md).
CASER_REFRESH_TOKEN=

# Supabase secret key: Supabase dashboard, Project Settings, API Keys, "Secret keys" (sb_secret_...).
# It can write everything in the project, so it stays on this server only.
SUPABASE_SECRET_KEY=

# Alerts (optional but recommended): a webhook that gets a message when something goes wrong
# (login refused, blocked, long pauses, failing requests, crashes) or the monitor stops reporting.
#   ntfy (easiest: install the ntfy app, subscribe to a long random topic name):  https://ntfy.sh/<your-topic>
#   Discord: a channel's webhook URL                                              https://discord.com/api/webhooks/...
#   Telegram: a bot token and your chat id                                        https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
ALERT_URL=

# Optional.
# SUPABASE_URL=https://hafnhxumrqyaljmciqqq.supabase.co
# RETENTION_DAYS=90
# HISTORY_DAYS=7
# HISTORY_PAGES=10
# REVISIT_HOURS=6
# REVISIT_STALE_HOURS=24
# COUNTER_CHECKS=1
# FEED_MAX_SECONDS=90
# CASER_BASE=https://caser.gg
# PULSE_GAP_MS=8000
